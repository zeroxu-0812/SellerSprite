# ===== 鉴权 =====

# 客户端稳定值（从扩展抓包获取一次即可，长期不变）：
KEEPA_AUTH_FP=
KEEPA_RANDOM_TOKEN=
KEEPA_COOKIE=

# auth-token 留空即可——下面的自动登录会刷新它。
# （模式 A 手动：也可直接填抓包 token，但几分钟就过期，不推荐）
KEEPA_AUTH_TOKEN=

# ===== 自动登录刷新（推荐，已实测）=====
# token 过期/缺失时，KeepaTokenManager 自动执行下面的命令，stdout 输出新 token JSON。
KEEPA_TOKEN_REFRESH_COMMAND=.venv/bin/python refresh_tokens.py
KEEPA_TOKEN_REFRESH_EACH_RUN=false
KEEPA_TOKEN_REFRESH_TIMEOUT_SECONDS=45
KEEPA_TOKEN_TTL_SECONDS=5400

# 卖家精灵登录账号：
KEEPA_LOGIN_USERNAME=
# 密码：填明文（KEEPA_LOGIN_PASSWORD_MD5=true 会自动 MD5）；或直接填 MD5 哈希并设 MD5=false
KEEPA_LOGIN_PASSWORD=
KEEPA_LOGIN_PASSWORD_MD5=true
KEEPA_LOGIN_URL=https://www.sellersprite.com/v2/extension/signin
KEEPA_LOGIN_VERSION=5.0.4

# 登录响应里 auth-token 的字段路径（默认 data.token，一般不用改）：
# KEEPA_RESPONSE_AUTH_TOKEN_PATH=data.token
