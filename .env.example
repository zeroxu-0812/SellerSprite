# ===== 鉴权：两种模式二选一 =====

# 模式 A（手动）：直接填从 devtools 抓包得到的 token。
#   缺点：卖家精灵登录态几分钟就过期，需频繁重抓。
KEEPA_AUTH_TOKEN=
KEEPA_AUTH_FP=
KEEPA_RANDOM_TOKEN=
KEEPA_COOKIE=

# 模式 B（自动，推荐）：填卖家精灵登录账号，程序过期时自动登录刷新。
#   配好后上面 4 个 token 可留空——首次用到时自动登录拿新 token 并缓存。
KEEPA_TOKEN_REFRESH_COMMAND=.venv/bin/python refresh_tokens.py
KEEPA_TOKEN_REFRESH_EACH_RUN=false
KEEPA_TOKEN_REFRESH_TIMEOUT_SECONDS=45
KEEPA_TOKEN_TTL_SECONDS=5400

# 卖家精灵登录账号（自动刷新用）：
KEEPA_LOGIN_USERNAME=
KEEPA_LOGIN_PASSWORD=
# 登录 API 地址（需抓包获取：扩展登录时 F12 抓那条登录请求的 URL）
KEEPA_LOGIN_URL=
KEEPA_LOGIN_PASSWORD_MD5=true
KEEPA_LOGIN_VERSION=5.0.4

# 若登录响应字段路径与默认不同，可在这里覆盖（默认 data.token / auth-fp / random-token / cookie）：
# KEEPA_RESPONSE_AUTH_TOKEN_PATH=data.token
# KEEPA_RESPONSE_AUTH_FP_PATH=auth-fp
# KEEPA_RESPONSE_RANDOM_TOKEN_PATH=random-token
# KEEPA_RESPONSE_COOKIE_PATH=cookie
