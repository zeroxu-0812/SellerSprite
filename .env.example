# ===== 鉴权 =====

# 最小配置：只需要卖家精灵登录账号和密码。
KEEPA_LOGIN_USERNAME=
KEEPA_LOGIN_PASSWORD=

# 密码默认填明文，程序会自动 MD5。
# 如果这里直接填的是 MD5 哈希，改成 false。
KEEPA_LOGIN_PASSWORD_MD5=true

# ===== 可选项 =====

# 默认会自动执行 refresh_tokens.py 刷新 auth-token；一般不用填。
# 如需覆盖 Python 命令或路径，再打开下面这行：
# KEEPA_TOKEN_REFRESH_COMMAND=python3 refresh_tokens.py

# token 刷新策略。
KEEPA_TOKEN_REFRESH_EACH_RUN=false
KEEPA_TOKEN_REFRESH_TIMEOUT_SECONDS=45
KEEPA_TOKEN_TTL_SECONDS=5400

# auth-fp / random-token 默认自动生成并缓存到 .client_tokens.json。
# 如果线上接口校验变严格，可从浏览器扩展请求头抓包后手动覆盖：
# KEEPA_AUTH_FP=
# KEEPA_RANDOM_TOKEN=
# KEEPA_COOKIE=

# 手动 auth-token 不推荐，几分钟就会过期；通常留空。
# KEEPA_AUTH_TOKEN=

KEEPA_LOGIN_URL=https://www.sellersprite.com/v2/extension/signin
KEEPA_LOGIN_VERSION=5.0.4

# 登录响应里 auth-token 的字段路径（默认 data.token，一般不用改）：
# KEEPA_RESPONSE_AUTH_TOKEN_PATH=data.token

# ===== 工作台管理员权限 =====
# 建议只保存 SHA-256 值，不要把明文密码提交到代码仓库。
SELLERSPRITE_ADMIN_USERNAME=admin
SELLERSPRITE_ADMIN_PASSWORD_SHA256=
# 使用明文密码也可以，但与 SHA-256 同时存在时优先使用 SHA-256。
# SELLERSPRITE_ADMIN_PASSWORD=
SELLERSPRITE_ADMIN_SESSION_TTL_SECONDS=28800

# ===== 抓取任务并发保护（单实例部署） =====
# 同时真正执行的任务数；其余任务进入内存队列。
SELLERSPRITE_MAX_ACTIVE_JOBS=2
# 内存中最多保留的任务记录；达到上限时优先清理已完成/失败任务。
SELLERSPRITE_MAX_JOB_RECORDS=500
# 单任务最多允许提交的 ASIN 数量。
SELLERSPRITE_MAX_ASINS=100
# 单任务 Amazon 详情页最大并发，后端会强制限制客户端传入值。
SELLERSPRITE_MAX_DETAIL_WORKERS=2

# ===== SIF 流量分析（产品对比表按行自动加载） =====
# 用于读取自然、广告、推荐流量的最近30天占比，并固化到导出的 HTML。与卖家精灵账号独立。
# 可配置 1-10 组账号；认证失效时依次尝试下一组。不要提交真实凭据。
SIF_USERNAME_1=
SIF_PASSWORD_1=
SIF_USERNAME_2=
SIF_PASSWORD_2=
SIF_USERNAME_3=
SIF_PASSWORD_3=
# 仍兼容单账号 SIF_USERNAME/SIF_PASSWORD（以及 SIF_PHONE/SIF_ACCOUNT）。
# 默认 https://www.sif.com；仅在 SIF 环境地址变化时覆盖。
# SIF_BASE_URL=https://www.sif.com
# 同时允许处理的流量分析请求数。建议保持 1，避免对 SIF 形成突发请求。
SIF_TRAFFIC_MAX_ACTIVE_REQUESTS=1
# 同一站点 ASIN 的最近30天结果缓存时间，减少结果表重复请求。
SIF_TRAFFIC_CACHE_SECONDS=1800
# 相邻请求间加入随机等待；服务端会强制不低于 500ms。
SIF_REQUEST_DELAY_MS_MIN=900
SIF_REQUEST_DELAY_MS_MAX=1600
# 网络或 5xx 异常的退避基数；最多自动重试 2 次。
SIF_RETRY_BACKOFF_MS=1500
# 检测到 403、429 或风控提示后，所有 SIF 请求进入全局冷却。
SIF_RISK_COOLDOWN_SECONDS=300
